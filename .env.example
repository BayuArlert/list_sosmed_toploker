# Salin ke .env untuk development lokal
PORT=3000
SPREADSHEET_ID=your_spreadsheet_id_here

# Opsional lokal: pakai file credentials.json saja
# Untuk Railway: wajib set GOOGLE_CREDENTIALS (isi penuh JSON service account, 1 baris)
# GOOGLE_CREDENTIALS={"type":"service_account",...}

# SHEETS_DATE_MODE=closest
# closest (default) = kolom tanggal terdekat ke hari ini, mundur atau maju (tgl 1 → kolom tgl 6 OK)
# nearest  = tanggal hari ini, fallback ke tanggal terdekat <= hari ini
# upcoming = tanggal hari ini, fallback ke tanggal terdekat >= hari ini
# exact    = hanya tulis jika ada kolom tanggal persis hari ini
# latest   = tulis ke kolom tanggal terbaru di bulan ini
# IG_COOKIES_JSON=[{"name":"sessionid",...}]
